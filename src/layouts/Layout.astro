---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vibhu Tummallapalli — AI Engineer in Charlotte, NC',
  description = 'Vibhu Tummallapalli is an AI engineer in Charlotte, NC, focused on agentic AI systems, LLM application development, and applied AI/ML. B.S. Software Engineering at East Carolina University; M.S. Artificial Intelligence at UNC Charlotte.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/images/profile.jpg', Astro.site).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vibhu Tummallapalli',
  alternateName: 'Vibhu',
  url: 'https://vibhutummallapalli.com',
  image: ogImage,
  jobTitle: 'AI Engineer',
  description:
    'AI engineer focused on agentic AI systems, LLM application development, and applied AI/ML.',
  email: `mailto:${profile.email}`,
  telephone: `+1-${profile.phone}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Charlotte',
    addressRegion: 'NC',
    addressCountry: 'US',
  },
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'East Carolina University',
      sameAs: 'https://www.ecu.edu/',
    },
  ],
  sameAs: [
    'https://github.com/VibhuTummallapalli',
    'https://linkedin.com/in/vibhutummallapalli',
  ],
  knowsAbout: [
    'Artificial Intelligence Engineering',
    'Agentic AI Systems',
    'Large Language Models',
    'Multi-Agent Systems',
    'LLM Application Development',
    'Model Context Protocol',
    'Software Engineering',
  ],
  nationality: {
    '@type': 'Country',
    name: 'United States',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Vibhu Tummallapalli" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="2AQ9wj4aAsQG5qSL308J6lsY4vhFLevMpn5nonev1eI" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Vibhu Tummallapalli" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif&display=swap"
      rel="stylesheet"
    />

    <!-- Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  </head>
  <body class="bg-stone-50 min-h-screen text-stone-800 font-sans">
    <slot />

    <script is:inline>
      // Scroll reveal — opt into the hidden state from JS so no-JS users
      // see content immediately. Respect prefers-reduced-motion.
      (() => {
        const motionOK = window.matchMedia(
          '(prefers-reduced-motion: no-preference)'
        ).matches;
        if (!motionOK) return;

        const targets = document.querySelectorAll('[data-reveal]');
        if (!targets.length) return;

        targets.forEach((el) => el.classList.add('is-armed'));

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );

        targets.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight) {
            requestAnimationFrame(() => el.classList.add('is-revealed'));
          } else {
            observer.observe(el);
          }
        });
      })();
    </script>
  </body>
</html>
