---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { profile, experience, projects, skillGroups } from '../data/site';

const base = import.meta.env.BASE_URL;
const asset = (p: string) =>
  `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;

// Concise project summaries (independent of CV bullet copy)
const projectMeta: Record<string, { summary: string; role: string }> = {
  'NC Early Mathematics Placement Testing': {
    role: 'Senior Capstone · 5-person Agile team',
    summary:
      'Full-stack web platform used by 60 NC high schools and 5,000+ students. Built role-based access with JWT + 2FA, real-time proctor monitoring via SignalR, and an async email pipeline on GCP Pub/Sub. Shipped through GitHub Actions CI/CD.',
  },
  'Metamorphic Testing of Multi-Agent AI Systems': {
    role: 'Research',
    summary:
      'A novel catalog of 9 metamorphic relations for testing multi-agent LLM systems where traditional oracles fail — interchangeability, redundancy invariance, graceful degradation. Reusable Python framework with semantic verifiers; CrewAI harnesses across OpenAI and Ollama via LangChain.',
  },
  'Dental Charting Tool': {
    role: 'Applied research · ECU School of Dental Medicine',
    summary:
      'WPF/.NET desktop app for radiograph analysis with GPT-4o Vision, FDI tooth-numbering, CDT-coded procedure cataloging, and urgency triage. 5-step prompt pipeline for clinically contextualized output. Presented at ECU RCAW and CORAS 2026.',
  },
};

// Compact experience summaries
const experienceMeta: Record<string, string> = {
  'Undergraduate Research Assistant':
    'Built data ingestion prototypes in Python, C#, and Java across three faculty research projects in health tech and cybersecurity. Maintained Python/Maven environments and local LLM integrations supporting team-wide reproducibility.',
  'Learning Assistant':
    'Tutored 50+ students in Algebra, Calculus, and Statistics through weekly review sessions and office hours — raising failing test scores to 80%+ and helping 75% of students earn a 4.0 in the course.',
};

const yearRange = (s: string) =>
  s.replace(/\s*\(Expected\)/, '').replace(/–/g, '—');
---

<Layout>
  <Nav />

  <span id="top"></span>

  <main class="container-prose">

    <!-- Hero -->
    <section class="pt-20 md:pt-32 pb-16 md:pb-24">
      <div class="flex flex-col-reverse md:flex-row md:items-start md:justify-between gap-10">
        <div class="flex-1">
          <p class="eyebrow mb-6">Software engineer · Charlotte, NC</p>
          <h1 class="font-serif text-stone-900 text-5xl md:text-7xl leading-[1.02] tracking-tight mb-8">
            Hi, I'm Vibhu.
          </h1>
          <p class="text-xl md:text-2xl text-stone-700 leading-snug font-light mb-10 max-w-xl">
            I build full-stack tools, LLM applications, and security research
            prototypes — usually somewhere at the intersection.
          </p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
            <a href={`mailto:${profile.email}`} class="arrow-link">Email</a>
            <a href={profile.github} target="_blank" rel="noopener noreferrer" class="arrow-link">GitHub</a>
            <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="arrow-link">LinkedIn</a>
          </div>
        </div>

        <div class="flex-shrink-0">
          <img
            src={asset('images/profile.jpg')}
            alt={`Portrait of ${profile.name}`}
            class="w-64 md:w-80 h-auto rounded-2xl ring-1 ring-stone-200"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <!-- Currently -->
    <section class="pb-4">
      <div class="grid md:grid-cols-[auto_1fr] md:gap-12 gap-3">
        <p class="eyebrow md:pt-1">Currently</p>
        <p class="text-lg text-stone-700 leading-relaxed">
          Finishing my B.S. in <span class="text-stone-900">Software Engineering</span> at
          East Carolina University. Starting an M.S. in <span class="text-stone-900">Cybersecurity</span>
          at UNC Charlotte this fall. Looking for
          <span class="text-stone-900">full-time, part-time, and internship</span> roles
          in the greater Charlotte area.
        </p>
      </div>
    </section>

    <div class="rule"></div>

    <!-- Selected work -->
    <section id="work">
      <div class="flex items-baseline justify-between mb-12">
        <h2 class="eyebrow">Selected work</h2>
        <span class="text-xs text-stone-400">2025 — 2026</span>
      </div>

      <ol class="space-y-16">
        {
          projects.map((p, i) => {
            const meta = projectMeta[p.name];
            return (
              <li>
                <div class="flex items-start gap-5 md:gap-8">
                  <span class="font-serif text-3xl md:text-4xl text-stone-300 leading-none pt-1 w-12 md:w-14 flex-shrink-0 tabular-nums">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div class="flex-1 min-w-0">
                    <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 mb-2">
                      <h3 class="text-xl md:text-2xl font-semibold text-stone-900 tracking-tight">
                        {p.name}
                      </h3>
                      <span class="text-xs text-stone-400 whitespace-nowrap tabular-nums">
                        {yearRange(p.dates)}
                      </span>
                    </div>
                    {meta && (
                      <p class="text-sm text-stone-500 mb-4">{meta.role}</p>
                    )}
                    <p class="text-base text-stone-700 leading-relaxed mb-5 max-w-2xl">
                      {meta?.summary ?? p.bullets[0]}
                    </p>
                    <div class="flex flex-wrap gap-x-3 gap-y-1">
                      {
                        p.tags.map((t, idx) => (
                          <>
                            {idx > 0 && <span class="text-stone-300">·</span>}
                            <span class="tag">{t}</span>
                          </>
                        ))
                      }
                    </div>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ol>
    </section>

    <div class="rule"></div>

    <!-- Experience -->
    <section id="experience">
      <h2 class="eyebrow mb-12">Experience</h2>
      <ol class="space-y-12">
        {
          experience.map((e) => (
            <li class="grid md:grid-cols-[10rem_1fr] gap-2 md:gap-10">
              <p class="text-sm text-stone-400 tabular-nums tracking-wide whitespace-nowrap md:pt-1">
                {yearRange(e.dates)}
              </p>
              <div>
                <h3 class="text-lg font-semibold text-stone-900 tracking-tight">
                  {e.role}
                </h3>
                <p class="text-sm text-stone-500 mb-3">{e.org}</p>
                <p class="text-base text-stone-700 leading-relaxed max-w-2xl">
                  {experienceMeta[e.role] ?? e.bullets[0]}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="rule"></div>

    <!-- Stack -->
    <section id="stack">
      <h2 class="eyebrow mb-12">Stack</h2>
      <dl class="space-y-7">
        {
          skillGroups.map((group) => (
            <div class="grid md:grid-cols-[10rem_1fr] gap-2 md:gap-10 items-baseline">
              <dt class="text-sm text-stone-500 whitespace-nowrap">
                {group.title}
              </dt>
              <dd class="flex flex-wrap gap-x-3 gap-y-1.5">
                {
                  group.items.map((item, idx) => (
                    <>
                      {idx > 0 && <span class="text-stone-300">·</span>}
                      <span class="text-base text-stone-800">{item}</span>
                    </>
                  ))
                }
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="rule"></div>

    <!-- Contact -->
    <section id="contact" class="pb-12">
      <h2 class="eyebrow mb-6">Get in touch</h2>
      <p class="font-serif text-3xl md:text-5xl text-stone-900 leading-tight tracking-tight mb-8 max-w-2xl">
        Open to new grad roles, internships, and research collaborations.
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href={`mailto:${profile.email}`} class="arrow-link text-base">
          {profile.email}
        </a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer" class="arrow-link text-base">
          GitHub
        </a>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="arrow-link text-base">
          LinkedIn
        </a>
      </div>
    </section>

  </main>

  <footer class="container-prose pb-16 pt-8">
    <div class="border-t border-stone-200 pt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <p class="text-xs text-stone-500">
        © {new Date().getFullYear()} {profile.name}
      </p>
      <p class="text-xs text-stone-400">
        Built with Astro & Tailwind. Hosted on GitHub Pages.
      </p>
    </div>
  </footer>
</Layout>
