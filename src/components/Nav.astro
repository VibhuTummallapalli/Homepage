---
const links = [
  { href: '#about', label: 'About' },
  { href: '#education', label: 'Education' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 bg-stone-50/80 backdrop-blur-md border-b border-stone-200/60">
  <nav class="container mx-auto px-6 py-4">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <a href="#" class="text-lg font-semibold text-stone-900 tracking-tight">
        Vibhu Tummallapalli
      </a>
      <ul class="flex flex-wrap justify-center gap-6 md:gap-8">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-sm font-medium text-stone-600 hover:text-stone-900 transition-colors"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>
