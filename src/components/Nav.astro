---
const links = [
  { href: '#work', label: 'Work' },
  { href: '#experience', label: 'Experience' },
  { href: '#stack', label: 'Stack' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 bg-navy-900/95 backdrop-blur-md border-b border-navy-800">
  <div class="container-prose">
    <nav class="flex items-center justify-between py-4">
      <a
        href="#top"
        class="text-sm font-semibold text-white tracking-tight hover:text-navy-200 transition-colors"
      >
        Vibhu Tummallapalli
      </a>
      <ul class="flex items-center gap-5 md:gap-7">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-sm text-navy-200 hover:text-white transition-colors"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
