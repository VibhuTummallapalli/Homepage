---
const links = [
  { href: '#work', label: 'Work' },
  { href: '#experience', label: 'Experience' },
  { href: '#stack', label: 'Stack' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 bg-stone-50/70 backdrop-blur-md">
  <div class="container-prose">
    <nav class="flex items-center justify-between py-5 border-b border-stone-200/70">
      <a href="#top" class="text-sm font-semibold text-stone-900 tracking-tight">
        Vibhu Tummallapalli
      </a>
      <ul class="flex items-center gap-6">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-sm text-stone-500 hover:text-stone-900 transition-colors"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
